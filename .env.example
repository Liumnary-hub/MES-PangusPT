# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=change-me

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=mes
RABBITMQ_PASSWORD=change-me

# JWT（Base64 编码，至少 32 字节）
JWT_SECRET=replace-with-base64-secret

# WMS 集成
WMS_ENABLED=true
WMS_BASE_URL=http://localhost:8088
WMS_API_KEY=change-me
WMS_FG_WAREHOUSE_CODE=FG01
WMS_CONNECT_TIMEOUT_MS=3000
WMS_READ_TIMEOUT_MS=5000

# Modbus TCP
MODBUS_ENABLED=false
MODBUS_SIMULATOR=false
MODBUS_HOST=localhost
MODBUS_PORT=5020
MODBUS_TASK_ID=1
