<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mes.mapper.QualityStandardMapper">

    <resultMap id="BaseResultMap" type="com.mes.entity.QualityStandard">
        <id column="id" property="id" />
        <result column="standard_code" property="standardCode" />
        <result column="standard_name" property="standardName" />
        <result column="product_id" property="productId" />
        <result column="inspection_type" property="inspectionType" />
        <result column="inspection_level" property="inspectionLevel" />
        <result column="aql_level" property="aqlLevel" />
        <result column="acceptance_criteria" property="acceptanceCriteria" />
        <result column="status" property="status" />
        <result column="version" property="version" />
        <result column="remark" property="remark" />
        <result column="effective_date" property="effectiveDate" />
        <result column="expire_date" property="expireDate" />
        <result column="create_by" property="createBy" />
        <result column="create_time" property="createTime" />
        <result column="update_by" property="updateBy" />
        <result column="update_time" property="updateTime" />
    </resultMap>

    <sql id="Base_Column_List">
        id, standard_code, standard_name, product_id, inspection_type, inspection_level,
        aql_level, acceptance_criteria, status, version, remark, effective_date,
        expire_date, create_by, create_time, update_by, update_time
    </sql>

    <!-- 分页查询检验标准列表 -->
    <select id="selectStandardList" resultMap="BaseResultMap">
        SELECT
        s.*,
        p.product_code,
        p.product_name
        FROM mes_quality_standard s
        LEFT JOIN mes_product_definition p ON s.product_id = p.id
        <where>
            <if test="standardCode != null and standardCode != ''">
                AND s.standard_code LIKE CONCAT('%', #{standardCode}, '%')
            </if>
            <if test="standardName != null and standardName != ''">
                AND s.standard_name LIKE CONCAT('%', #{standardName}, '%')
            </if>
            <if test="productCode != null and productCode != ''">
                AND p.product_code = #{productCode}
            </if>
            <if test="status != null and status != ''">
                AND s.status = #{status}
            </if>
        </where>
        ORDER BY s.create_time DESC
    </select>

    <!-- 根据标准编号查询 -->
    <select id="selectByCode" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List" />
        FROM mes_quality_standard
        WHERE standard_code = #{standardCode}
    </select>

    <!-- 根据标准编号统计数量 -->
    <select id="countByStandardCode" resultType="java.lang.Long">
        SELECT COUNT(1)
        FROM mes_quality_standard
        WHERE standard_code = #{standardCode}
    </select>

    <!-- 根据产品ID和检验类型查询检验标准 -->
    <select id="selectByProductAndType" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List" />
        FROM mes_quality_standard
        <where>
            product_id = #{productId}
            <if test="inspectionType != null and inspectionType != ''">
                AND inspection_type = #{inspectionType}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
        </where>
        ORDER BY create_time DESC
    </select>

    <!-- 根据产品ID查询检验标准 -->
    <select id="selectByProductId" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List" />
        FROM mes_quality_standard
        WHERE product_id = #{productId}
        ORDER BY create_time DESC
    </select>

    <!-- 更新标准状态 -->
    <update id="updateStatus">
        UPDATE mes_quality_standard
        SET status = #{status},
            update_by = #{updateBy},
            update_time = #{updateTime}
        WHERE id = #{id}
    </update>

    <!-- 批量删除检验标准 -->
    <delete id="deleteBatch">
        DELETE FROM mes_quality_standard
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>